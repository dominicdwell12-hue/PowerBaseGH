# Server
NODE_ENV=development
PORT=5000
API_BASE_PATH=/api/v1

# Database (MySQL)
DATABASE_URL="mysql://root:password@localhost:3306/powerbase_gh"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Payment gateways
PAYSTACK_SECRET_KEY=your_paystack_secret_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key
FLUTTERWAVE_WEBHOOK_HASH=your_flutterwave_webhook_secret_hash
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback

# CORS — comma separated origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
