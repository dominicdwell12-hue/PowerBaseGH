# --- Core ---
NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Database ---
DATABASE_URL="mysql://user:password@localhost:3306/powerbase_gh"

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Cloudinary (product images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (Paystack / Flutterwave) ---
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENT_CALLBACK_URL=http://localhost:5173/payment/callback

# --- Transactional email (Resend) ---
# Get a key at https://resend.com — used to send "Forgot Password" emails.
RESEND_API_KEY=
EMAIL_FROM="PowerBase.Gh <onboarding@resend.dev>"

# Storefront page the reset link points to. Must match a route in the
# storefront app that reads ?token= and ?email= from the query string.
RESET_PASSWORD_URL=http://localhost:5173/reset-password
